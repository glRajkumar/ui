{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "declaration": true,
    "paths": {
      "@/*": ["../../*"]
    }
  },
  "include": [
    "../../components/ui",
    "../../lib/utils.ts",
    "../../lib/menu.ts",
    "../../hooks/use-mobile.ts",
    "../../types"
  ]
}

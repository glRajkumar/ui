{
  "name": "@glraj/ui",
  "version": "0.2.0",
  "description": "Opinionated, type-safe wrappers around shadcn/ui (Base UI) components.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://ui.glrk.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glRajkumar/ui.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "theme.css"
  ],
  "exports": {
    "./styles.css": "./styles.css",
    "./theme.css": "./theme.css",
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./menu-utils": {
      "types": "./dist/lib/menu.d.ts",
      "import": "./dist/lib/menu.js"
    },
    "./use-mobile": {
      "types": "./dist/hooks/use-mobile.d.ts",
      "import": "./dist/hooks/use-mobile.js"
    },
    "./data-table": {
      "types": "./dist/components/ui/data-table/index.d.ts",
      "import": "./dist/components/ui/data-table/index.js"
    },
    "./data-table/no-virtual": {
      "types": "./dist/components/ui/data-table/index-no-virt.d.ts",
      "import": "./dist/components/ui/data-table/index-no-virt.js"
    },
    "./date-picker": {
      "types": "./dist/components/ui/date-picker/index.d.ts",
      "import": "./dist/components/ui/date-picker/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css theme.css",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.0.0",
    "@tanstack/react-virtual": "^3.14.15",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": ">=1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@daypicker/react": {
      "optional": true
    },
    "@tanstack/react-form": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "@tanstack/react-virtual": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "embla-carousel-react": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "publint": "^0.3.12",
    "tsdown": "0.23.1",
    "typescript": "^6.0.3",
    "unrun": "~0.2.39"
  }
}
